<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".screens.contacts.ContactActivity">
    <View
        android:id="@+id/contact_view_top_part"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/primary_background"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_percent="@dimen/height_percent_top_part"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="@dimen/bias_top_view" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/contact_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintVertical_bias="@dimen/bias_vertical_contact_title"
        android:layout_margin="@dimen/margin_text_contact"
        android:gravity="center_vertical"
        android:text="@string/contacts"
        android:textAppearance="@style/textAppearance_title_text"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toEndOf="@id/contact_back_button"
        app:layout_constraintEnd_toStartOf="@id/contact_search"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/contact_view_top_part"/>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/contact_back_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/contact_title"
        app:layout_constraintTop_toTopOf="@id/contact_title"
        app:layout_constraintBottom_toBottomOf="@id/contact_title"
        android:layout_marginStart="@dimen/margin_button_contact"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/baseline_arrow_back_24"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintVertical_bias="@dimen/bias_vertical_contact_top_information" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/contact_search"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/contact_title"
        app:layout_constraintTop_toTopOf="@id/contact_title"
        app:layout_constraintBottom_toBottomOf="@id/contact_title"
        android:layout_marginEnd="@dimen/margin_button_contact"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/group_2"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
         />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/contact_add_contacts"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintVertical_bias="@dimen/bias_vertical_contact_add_button"
        android:layout_marginStart="@dimen/margin_button_contact"
        android:gravity="center_vertical"
        android:text="@string/add_contacts"
        android:textAppearance="@style/textAppearance_medium_bright_text"
        app:layout_constraintTop_toBottomOf="@id/contact_back_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/contact_view_top_part" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewContacts"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/contact_view_top_part"
        app:layout_constraintVertical_bias="0.0"
        tools:listitem="@layout/contact_item" />

</androidx.constraintlayout.widget.ConstraintLayout>