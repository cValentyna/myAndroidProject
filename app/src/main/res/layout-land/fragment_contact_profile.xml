<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/contact_profile_fragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/secondary_background"
    android:theme="@style/Theme.MyApp"
    tools:context=".screens.fragments.ContactProfileFragment">

    <View
        android:id="@+id/ViewContactProfileLeftPart"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/primary_background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="@dimen/bias_top_view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="@dimen/height_percent_top_view" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/contact_back_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_button_contact"
        android:src="@drawable/baseline_arrow_back_24"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:layout_constraintBottom_toBottomOf="@id/textViewProfile"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/textViewProfile"
        app:layout_constraintHorizontal_bias="0"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/textViewProfile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_marginVertical="@dimen/margin_settings_top"
        android:text="@string/profile"
        android:textAppearance="@style/textAppearance_log_in_fill_text"
        app:layout_constraintStart_toStartOf="@id/ViewContactProfileLeftPart"
        app:layout_constraintEnd_toEndOf="@id/ViewContactProfileLeftPart"
        app:layout_constraintTop_toTopOf="@id/ViewContactProfileLeftPart" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/contact_image_view"
        android:transitionName="userPhoto"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="@dimen/alpha_image_view"
        android:background="@color/secondary_background"
        android:scaleType="centerCrop"
        android:src="@drawable/person_icon_png_transparent_15"
        app:shapeAppearanceOverlay="@style/shapeAppearance_image"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintHeight_percent="@dimen/size_percent_image"
        app:layout_constraintStart_toStartOf="@id/ViewContactProfileLeftPart"
        app:layout_constraintTop_toBottomOf="@id/textViewProfile"
        app:layout_constraintBottom_toBottomOf="@id/ViewContactProfileLeftPart"
        app:layout_constraintEnd_toEndOf="@id/ViewContactProfileLeftPart"
        app:layout_constraintVertical_bias="@dimen/bias_vertical_card_view"
        android:contentDescription="@string/main_user_photo"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/textViewProfileUserName"
        android:transitionName="userName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_top_user_name"
        android:text="@string/main_user_name"
        android:textAppearance="@style/textAppearance_log_in_fill_text"
        app:layout_constraintBottom_toTopOf="@id/textViewProfileUserJob"
        app:layout_constraintEnd_toEndOf="@id/ViewContactProfileLeftPart"
        app:layout_constraintStart_toStartOf="@id/ViewContactProfileLeftPart"
        app:layout_constraintTop_toBottomOf="@id/contact_image_view"
        app:layout_constraintVertical_bias="@dimen/bias_vertical_user_name"
        app:layout_constraintVertical_chainStyle="packed" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/textViewProfileUserJob"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_top_user_name"
        android:text="@string/main_user_career"
        android:textAppearance="@style/textAppearance_light_medium_text"
        app:layout_constraintBottom_toTopOf="@id/textViewProfileUserAddress"
        app:layout_constraintEnd_toEndOf="@id/ViewContactProfileLeftPart"
        app:layout_constraintStart_toStartOf="@id/ViewContactProfileLeftPart"
        app:layout_constraintTop_toBottomOf="@id/textViewProfileUserName" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/textViewProfileUserAddress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/main_user_address"
        android:textAppearance="@style/textAppearance_light_medium_text"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/ViewContactProfileLeftPart"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textViewProfileUserJob" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/imageViewProfileFacebook"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/margin_social_networks"
        android:src="@drawable/main_full_fb"
        app:layout_constraintBottom_toTopOf="@id/buttonProfileMessage"
        app:layout_constraintEnd_toStartOf="@id/imageViewProfileLinkedin"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@id/ViewContactProfileLeftPart"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="@dimen/bias_vertical_social_network_frame"
        />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/imageViewProfileLinkedin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margin_social_networks"
        android:src="@drawable/main_full_ln"
        app:layout_constraintBottom_toTopOf="@id/buttonProfileMessage"
        app:layout_constraintEnd_toStartOf="@id/imageViewProfileInstagram"
        app:layout_constraintStart_toEndOf="@id/imageViewProfileFacebook"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="@dimen/bias_vertical_social_network_frame" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/imageViewProfileInstagram"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_social_networks"
        android:scaleType="centerCrop"
        android:src="@drawable/main_full_insta"
        app:layout_constraintBottom_toTopOf="@id/buttonProfileMessage"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/imageViewProfileLinkedin"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="@dimen/bias_vertical_social_network_frame" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/buttonProfileMessage"
        android:layout_width="0dp"
        android:layout_height="@dimen/height_view_contact_button"
        android:layout_marginVertical="@dimen/margin_view_contact_button"
        android:background="@drawable/main_button_contacts"
        android:text="@string/message"
        android:textAppearance="@style/textAppearance_bt_contact"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/ViewContactProfileLeftPart"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="@dimen/bias_vertical_view_contacts_button"
        app:layout_constraintWidth_percent="@dimen/width_percent_big_button_profile"
        />

</androidx.constraintlayout.widget.ConstraintLayout>